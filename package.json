{
	"name": "caravan",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "pnpm --filter @caravan/backend build && pnpm --filter @caravan/frontend build",
		"check": "biome check . && pnpm typecheck",
		"dev": "pnpm --filter @caravan/backend build && pnpm --filter @caravan/frontend dev",
		"format": "biome format --write .",
		"package": "pnpm build && pnpm --filter @caravan/frontend package",
		"typecheck": "pnpm --recursive --if-present typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2"
	}
}
